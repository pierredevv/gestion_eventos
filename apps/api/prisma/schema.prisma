// Prisma schema for the event management platform.
//
// Design rules enforced here and in prisma/migrations/*/migration.sql:
// - Money is stored as NUMERIC(12,2). Never floats.
// - Ticket availability counters live in ticket_types but are protected by
//   CHECK constraints and updated atomically (see ADR 0005).
// - Partial unique indexes (not expressible in Prisma) are added in SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  EVENT_MANAGER
  PAYMENT_REVIEWER
  CHECK_IN_STAFF
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentSubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  HELD_FOR_REVIEW
  CONSUMED
  RELEASED
  EXPIRED
}

enum NotificationType {
  ORDER_CREATED
  RECEIPT_RECEIVED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  ORDER_ACCESS_LINK
  TICKET_DELIVERY
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

enum AccessTokenScope {
  ORDER
  TICKETS
}

enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  fullName           String    @map("full_name") @db.VarChar(150)
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(6)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                UserRole[]
  sessions             Session[]
  orders               Order[]             @relation("OrderBuyer")
  createdEvents        Event[]             @relation("EventCreator")
  reviewedPayments     Payment[]           @relation("PaymentReviewer")
  reviewedSubmissions  PaymentSubmission[] @relation("SubmissionReviewer")
  submittedSubmissions PaymentSubmission[] @relation("SubmissionSubmitter")
  checkIns             CheckIn[]
  auditLogs            AuditLog[]
  verificationTokens   VerificationToken[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        RoleName   @unique
  description String     @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  email     String              @db.VarChar(254)
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Events and inventory
// ---------------------------------------------------------------------------

model Event {
  id                     String      @id @default(uuid()) @db.Uuid
  createdById            String      @map("created_by") @db.Uuid
  slug                   String      @unique @db.VarChar(120)
  title                  String      @db.VarChar(180)
  description            String      @db.Text
  coverImageKey          String?     @map("cover_image") @db.VarChar(255)
  location               String?     @db.VarChar(180)
  address                String?     @db.VarChar(255)
  timezone               String      @default("America/La_Paz") @db.VarChar(64)
  currency               String      @default("BOB") @db.Char(3)
  capacity               Int?
  /// When false, attendee name and email are optional at checkout.
  requireAttendeeDetails Boolean     @default(true) @map("require_attendee_details")
  /// When true, every attendee is derived from the buyer at checkout.
  personalPurchase       Boolean     @default(false) @map("personal_purchase")
  startDate              DateTime    @map("start_date") @db.Timestamptz(6)
  endDate                DateTime    @map("end_date") @db.Timestamptz(6)
  registrationStart      DateTime    @map("registration_start") @db.Timestamptz(6)
  registrationEnd        DateTime    @map("registration_end") @db.Timestamptz(6)
  status                 EventStatus @default(DRAFT)
  publishedAt            DateTime?   @map("published_at") @db.Timestamptz(6)
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  ticketTypes   TicketType[]
  orders        Order[]
  emailBranding EventEmailBranding?

  @@index([status, startDate])
  @@index([createdById])
  @@map("events")
}

/// Per-event email identity. Absent rows fall back to the platform brand.
model EventEmailBranding {
  eventId         String   @id @map("event_id") @db.Uuid
  brandName       String?  @map("brand_name") @db.VarChar(80)
  logoKey         String?  @map("logo_key") @db.VarChar(255)
  primaryColor    String?  @map("primary_color") @db.VarChar(7)
  textColor       String?  @map("text_color") @db.VarChar(7)
  backgroundColor String?  @map("background_color") @db.VarChar(7)
  /// Validated JSON: { ORDER_CREATED: { subject?, headline?, ... }, ... }
  templates       Json?
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_email_branding")
}

model TicketType {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  name             String   @db.VarChar(120)
  description      String?  @db.Text
  price            Decimal  @db.Decimal(12, 2)
  currency         String   @default("BOB") @db.Char(3)
  capacity         Int
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  soldQuantity     Int      @default(0) @map("sold_quantity")
  minPerOrder      Int      @default(1) @map("min_per_order")
  maxPerOrder      Int      @default(10) @map("max_per_order")
  salesStart       DateTime @map("sales_start") @db.Timestamptz(6)
  salesEnd         DateTime @map("sales_end") @db.Timestamptz(6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  reservations InventoryReservation[]
  tickets      Ticket[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
  @@map("ticket_types")
}

// ---------------------------------------------------------------------------
// Orders and attendees
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  buyerId         String?     @map("buyer_id") @db.Uuid
  eventId         String      @map("event_id") @db.Uuid
  orderCode       String      @unique @map("order_code") @db.VarChar(20)
  buyerName       String      @map("buyer_name") @db.VarChar(150)
  buyerEmail      String      @map("buyer_email") @db.VarChar(254)
  buyerPhone      String      @map("buyer_phone") @db.VarChar(30)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @map("discount") @db.Decimal(12, 2)
  discountReason  String?     @map("discount_reason") @db.VarChar(255)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency        String      @default("BOB") @db.Char(3)
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentAttempts Int         @default(0) @map("payment_attempts")
  idempotencyKey  String?     @unique @map("idempotency_key") @db.VarChar(100)
  expiresAt       DateTime?   @map("expires_at") @db.Timestamptz(6)
  confirmedAt     DateTime?   @map("confirmed_at") @db.Timestamptz(6)
  expiredAt       DateTime?   @map("expired_at") @db.Timestamptz(6)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  rejectionReason String?     @map("rejection_reason") @db.VarChar(255)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer        User?                  @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  payment      Payment?
  reservations InventoryReservation[]
  tickets      Ticket[]
  accessTokens OrderAccessToken[]

  @@index([eventId, status])
  @@index([buyerEmail])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  ticketTypeId   String  @map("ticket_type_id") @db.Uuid
  ticketTypeName String  @map("ticket_type_name") @db.VarChar(120)
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  attendees  Attendee[]

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model Attendee {
  id             String   @id @default(uuid()) @db.Uuid
  orderItemId    String   @map("order_item_id") @db.Uuid
  unitIndex      Int      @map("unit_index")
  fullName       String?  @map("full_name") @db.VarChar(150)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(30)
  documentNumber String?  @map("document_number") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@unique([orderItemId, unitIndex])
  @@index([email])
  @@map("attendees")
}

model InventoryReservation {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  ticketTypeId String            @map("ticket_type_id") @db.Uuid
  quantity     Int
  status       ReservationStatus @default(ACTIVE)
  expiresAt    DateTime?         @map("expires_at") @db.Timestamptz(6)
  releasedAt   DateTime?         @map("released_at") @db.Timestamptz(6)
  consumedAt   DateTime?         @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@unique([orderId, ticketTypeId])
  @@index([status, expiresAt])
  @@index([ticketTypeId])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @unique @map("order_id") @db.Uuid
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("BOB") @db.Char(3)
  status               PaymentStatus @default(PENDING)
  paymentReference     String?       @map("payment_reference") @db.VarChar(120)
  approvedSubmissionId String?       @unique @map("approved_submission_id") @db.Uuid
  reviewedById         String?       @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes          String?       @map("review_notes") @db.VarChar(500)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submissions        PaymentSubmission[] @relation("PaymentSubmissions")
  approvedSubmission PaymentSubmission?  @relation("PaymentApprovedSubmission", fields: [approvedSubmissionId], references: [id], onDelete: SetNull)
  reviewedBy         User?               @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reviewedById])
  @@map("payments")
}

model PaymentSubmission {
  id              String                  @id @default(uuid()) @db.Uuid
  paymentId       String                  @map("payment_id") @db.Uuid
  receiptFileKey  String                  @map("receipt_file_key") @db.VarChar(255)
  receiptMimeType String                  @map("receipt_mime_type") @db.VarChar(100)
  receiptSize     Int                     @map("receipt_size")
  receiptSha256   String                  @map("receipt_sha256") @db.VarChar(64)
  declaredAmount  Decimal                 @map("declared_amount") @db.Decimal(12, 2)
  submittedById   String?                 @map("submitted_by") @db.Uuid
  submittedAt     DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewStatus    PaymentSubmissionStatus @default(PENDING) @map("review_status")
  reviewedById    String?                 @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes     String?                 @map("review_notes") @db.VarChar(500)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  payment           Payment  @relation("PaymentSubmissions", fields: [paymentId], references: [id], onDelete: Cascade)
  submittedBy       User?    @relation("SubmissionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy        User?    @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedByPayment Payment? @relation("PaymentApprovedSubmission")

  @@index([paymentId, submittedAt])
  @@index([reviewStatus])
  @@map("payment_submissions")
}

// ---------------------------------------------------------------------------
// Tickets and access control
// ---------------------------------------------------------------------------

model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  attendeeId      String       @map("attendee_id") @db.Uuid
  ticketTypeId    String       @map("ticket_type_id") @db.Uuid
  ticketCode      String       @unique @map("ticket_code") @db.VarChar(24)
  tokenHash       String       @unique @map("token_hash") @db.VarChar(64)
  tokenCiphertext String       @map("token_ciphertext") @db.Text
  status          TicketStatus @default(VALID)
  issuedAt        DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  usedAt          DateTime?    @map("used_at") @db.Timestamptz(6)
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attendee   Attendee   @relation(fields: [attendeeId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  checkIn    CheckIn?

  @@index([orderId])
  @@index([attendeeId])
  @@index([ticketTypeId, status])
  @@map("tickets")
}

model CheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @unique @map("ticket_id") @db.Uuid
  checkedById String   @map("checked_by") @db.Uuid
  checkedAt   DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  checkedBy User   @relation(fields: [checkedById], references: [id], onDelete: Restrict)

  @@index([checkedAt])
  @@index([checkedById, checkedAt])
  @@map("check_ins")
}

model OrderAccessToken {
  id          String           @id @default(uuid()) @db.Uuid
  orderId     String           @map("order_id") @db.Uuid
  scope       AccessTokenScope
  tokenHash   String           @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?        @map("used_at") @db.Timestamptz(6)
  revokedAt   DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdByIp String?          @map("created_by_ip") @db.VarChar(45)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, scope])
  @@map("order_access_tokens")
}

// ---------------------------------------------------------------------------
// Notifications and auditing
// ---------------------------------------------------------------------------

model NotificationJob {
  id            String             @id @default(uuid()) @db.Uuid
  type          NotificationType
  recipient     String             @db.VarChar(254)
  payload       Json
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  maxAttempts   Int                @default(5) @map("max_attempts")
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt      DateTime?          @map("locked_at") @db.Timestamptz(6)
  lastError     String?            @map("last_error") @db.Text
  dedupeKey     String             @unique @map("dedupe_key") @db.VarChar(160)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("notification_jobs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  actorLabel String?  @map("actor_label") @db.VarChar(150)
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String   @map("entity_id") @db.VarChar(64)
  metadata   Json?
  requestId  String?  @map("request_id") @db.VarChar(64)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
