{
  "name": "@eventos/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST (NestJS) de la plataforma de gestion de eventos",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "prisma:format": "dotenv -e ../../.env -- prisma format",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:status": "dotenv -e ../../.env -- prisma migrate status",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:check": "dotenv -e ../../.env -- node --import tsx scripts/check-db.ts",
    "openapi:export": "pnpm build && dotenv -e ../../.env -- node dist/openapi.js",
    "openapi:types": "openapi-typescript openapi.json -o ../../packages/contracts/src/generated/api.d.ts",
    "openapi:generate": "pnpm openapi:export && pnpm openapi:types"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
