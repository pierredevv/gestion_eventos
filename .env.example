# =============================================================================
# API
# =============================================================================
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Comma-separated extra browser origins (Vercel previews, custom domains).
ADDITIONAL_WEB_ORIGINS=
# Web on Vercel and API on Railway are different sites: production must use
# `none` so the session and CSRF cookies are sent on cross-site fetch requests.
COOKIE_SAME_SITE=lax

# =============================================================================
# PostgreSQL (Supabase)
# -----------------------------------------------------------------------------
# Runtime (persistent backend on IPv4-only hosts such as Render): session pooler.
# Transaction pooler (port 6543) is also valid with pgbouncer=true&connection_limit=1.
# Migrations: direct connection (port 5432), only from hosts with IPv6 access.
# Replace <PASSWORD> and keep sslmode=require.
# =============================================================================
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Integration tests must never touch development data. They use a dedicated
# schema (`test`) inside the same project. Leave empty to skip DB integration tests.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# =============================================================================
# Supabase Storage (private buckets)
# =============================================================================
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Publishable (anon) key: safe for the browser, never used for privileged access.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET_RECEIPTS=receipts
SUPABASE_STORAGE_BUCKET_TICKETS=ticket-assets
SUPABASE_STORAGE_BUCKET_EVENT_ASSETS=event-assets

# =============================================================================
# Secrets
# -----------------------------------------------------------------------------
# 32 random bytes encoded in base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================
TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Business policies (never hardcode these in source code)
# =============================================================================
DEFAULT_CURRENCY=BOB
EVENT_TIMEZONE=America/La_Paz
RESERVATION_TTL_MINUTES=25
PAYMENT_RETRY_MAX_ATTEMPTS=2
PAYMENT_RETRY_WINDOW_HOURS=24
ORDER_ACCESS_LINK_TTL_HOURS=72
TICKET_ACCESS_TTL_DAYS_AFTER_EVENT=7
CHECKIN_WINDOW_BEFORE_HOURS=2
CHECKIN_WINDOW_AFTER_HOURS=1
MAX_RECEIPT_SIZE_MB=5
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# =============================================================================
# Email (adapter: console in development, resend in production)
# =============================================================================
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
# Display name shown to recipients; keep it under 70 characters.
EMAIL_FROM_NAME=Plataforma de Eventos
RESEND_API_KEY=
# Alternative HTTPS provider for hosts that block outbound SMTP ports:
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=

# =============================================================================
# Seed: first SUPER_ADMIN (temporary password, minimum 16 characters)
# =============================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# =============================================================================
# Web
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_DOCS_URL=http://localhost:4000/api/docs
NEXT_PUBLIC_API_HEALTH_URL=http://localhost:4000/api/v1/health/ready
# Public URL of the static bank QR image provided by the organiser. The system
# never generates it; host it where the organiser normally publishes it.
NEXT_PUBLIC_PAYMENT_QR_URL=
# Contact number shown next to the QR as a reference for payment inquiries.
NEXT_PUBLIC_PAYMENT_SUPPORT_PHONE=+591 62220214
# Informational only: shows the configured reservation window in the UI.
NEXT_PUBLIC_RESERVATION_MINUTES=25
